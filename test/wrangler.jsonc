{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "elo-agendor-mcp",
  "main": "../src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "vars": {
    "AGENDOR_CHAT_ACCOUNT_ID": "",
    "AGENDOR_CRM_TOKEN": "unit-crm-token",
    "AGENDOR_CHAT_TOKEN": "",
    "RUN_AGENDOR_CONTRACT_TESTS": "0",
    "ACCESS_CLIENT_ID": "unit-client",
    "ACCESS_CLIENT_SECRET": "unit-secret",
    "ACCESS_ISSUER": "https://elo-unit.cloudflareaccess.com",
    "ACCESS_AUTHORIZATION_URL": "https://elo-unit.cloudflareaccess.com/cdn-cgi/access/sso/oidc/unit-client/authorization",
    "ACCESS_TOKEN_URL": "https://elo-unit.cloudflareaccess.com/cdn-cgi/access/sso/oidc/unit-client/token",
    "ACCESS_JWKS_URL": "https://elo-unit.cloudflareaccess.com/cdn-cgi/access/sso/oidc/unit-client/jwks",
  },
  "define": {
    "__BUILD_COMMIT__": "\"unknown\"",
    "__ELO_DEPLOYMENT__": "{\"origin\":\"https://elo-agendor-mcp.example.workers.dev\",\"ownerEmail\":\"owner@elo.example\",\"tenantKey\":\"elotenant\",\"allowedInboxIds\":[4101,4102]}",
  },
  "durable_objects": { "bindings": [{ "name": "AUTOMATION_STATE", "class_name": "AutomationAccount" }] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "migrations": [{ "tag": "automation-v1", "new_sqlite_classes": ["AutomationAccount"] }],
  "queues": {
    "producers": [{ "binding": "AUTOMATION_QUEUE", "queue": "elo-agendor-operations" }],
    "consumers": [
      {
        "queue": "elo-agendor-operations",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 4,
        "dead_letter_queue": "elo-agendor-operations-dlq",
      },
    ],
  },
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } },
    { "name": "OAUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 10 } },
    { "name": "REGISTER_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
  ],
}
