AGENDOR_CRM_TOKEN="replace-me"
ACCESS_CLIENT_SECRET="replace-me"
# Optional independent Agendor Chat api_access_token; never reuse the CRM token.
# AGENDOR_CHAT_TOKEN="replace-me"
# Existing verified account ID is fixed by wrangler.jsonc; do not select another account here.
# AGENDOR_CHAT_ACCOUNT_ID="7001"
# Access public OIDC endpoints and infrastructure bindings are in wrangler.jsonc.
# No OpenAI/LLM secret is required. Never put credentials in URLs or Wrangler vars.
# AUTOMATION_CHAT_HINTS_ENABLED remains false (unsigned hint ingress is not a verified webhook).
# Application mode/capabilities/mappings/inbox allowlist/native creator state live in
# the versioned Durable Object policy, not environment variables. Initial policy is disabled.
# docs/rollout-pilot.json is a non-authorizing, empty-target rollout manifest.
