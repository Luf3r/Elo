// Example deployment configuration. Copy to wrangler.jsonc (ignored by Git) and
// replace every placeholder before deploying. See docs/operations/deploy.md.
// Never change "name" or __ELO_DEPLOYMENT__.tenantKey of an existing deployment:
// that creates another Worker and another Durable Object.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elo-agendor-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "secrets": { "required": ["AGENDOR_CRM_TOKEN", "ACCESS_CLIENT_SECRET"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "vars": {
    "AGENDOR_CHAT_ACCOUNT_ID": "1000",
    "ACCESS_CLIENT_ID": "example-client-id",
    "ACCESS_ISSUER": "https://example-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/example-client-id",
    "ACCESS_AUTHORIZATION_URL": "https://example-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/example-client-id/authorization",
    "ACCESS_TOKEN_URL": "https://example-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/example-client-id/token",
    "ACCESS_JWKS_URL": "https://example-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/example-client-id/jwks"
  },
  "define": {
    "__BUILD_COMMIT__": "\"unknown\"",
    "__ELO_DEPLOYMENT__": "{\"origin\":\"https://elo-agendor-mcp.example.workers.dev\",\"ownerEmail\":\"owner@example.com\",\"tenantKey\":\"acme\",\"allowedInboxIds\":[101,102]}"
  },
  "durable_objects": { "bindings": [{ "name": "AUTOMATION_STATE", "class_name": "AutomationAccount" }] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "migrations": [{ "tag": "automation-v1", "new_sqlite_classes": ["AutomationAccount"] }],
  "queues": {
    "producers": [{ "binding": "AUTOMATION_QUEUE", "queue": "elo-agendor-operations" }],
    "consumers": [{ "queue": "elo-agendor-operations", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 4, "dead_letter_queue": "elo-agendor-operations-dlq" }]
  },
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } },
    { "name": "OAUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 10 } }
  ],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
