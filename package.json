{
  "name": "elo-agendor-mcp",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:ephemeral": "node scripts/dev-ephemeral.mjs",
    "test": "vitest run --exclude=test/contract/**",
    "test:watch": "vitest --exclude=test/contract/**",
    "test:contract": "node scripts/run-contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:adapters && npm run test:scripts && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "docs:tools": "node scripts/docs-tools.mjs",
    "release": "node scripts/release.mjs",
    "deploy": "wrangler deploy",
    "inspector": "mcp-inspector",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "oauth:login": "node scripts/oauth-login.mjs",
    "verify:oauth": "node scripts/verify-oauth.mjs",
    "oauth:stage-secret": "node scripts/stage-oauth-secret.mjs",
    "test:scripts": "node --test test/oauth-scripts.test.mjs test/chat-contract-script.test.mjs test/oauth-lifetime.node.mjs test/automation-contract-script.test.mjs test/automation-verifier.test.mjs test/release-script.test.mjs test/docs-tools.test.mjs",
    "verify:automation": "node scripts/verify-automation-mcp.mjs",
    "discover:automation-contracts": "node scripts/discover-automation-contracts.mjs",
    "verify:chat-contract": "node scripts/verify-chat-contract.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "test:adapters": "vitest run --config vitest.adapters.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.29.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261021.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.11.0",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
